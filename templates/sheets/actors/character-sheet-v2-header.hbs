<header class="sheet-header">
    <div class="top-title">D U N E</div>
    <img class="" src="{{img}}" data-action="editImage" data-field="img" title="{{name}}"/>
    <div class="background">
        <div class="bg-name">{{ localize 'dune2d20.actor.name' }}</div>
        <div class="bg-start"></div>
        <div class="bg-data"><input name="name" type="text" value="{{name}}" placeholder="{{ localize 'dune2d20.actor.characterName' }}" {{#unless unlocked}}readonly{{/unless}}/></div>
        <div class="bg-end"></div>
        <div class="bg-name">{{ localize 'dune2d20.actor.house' }}</div>
        <div class="bg-start"></div>
        <div class="bg-data border">
            {{#if house}}
                <div class="house" data-house-id="{{house._id}}">{{house.name}}
                    {{#if unlocked}}<a data-action="removeHouse" title="{{localize 'dune2d20.hint.removeHouse'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>{{/if}}
                </div>
            {{/if}}
        </div>
        <div class="bg-end"></div>
        <div class="bg-name">{{ localize 'dune2d20.actor.role' }}</div>
        <div class="bg-start"></div>
        <div class="bg-data"><input name="system.role" type="text" value="{{system.role}}" {{#unless unlocked}}readonly{{/unless}}/></div>
        <div class="bg-end"></div>
        <div class="bg-name">{{ localize 'dune2d20.actor.faction' }}</div>
        <div class="bg-start"></div>
        <div class="bg-data"><input name="system.faction" type="text" value="{{system.faction}}" {{#unless unlocked}}readonly{{/unless}}/></div>
        <div class="bg-end"></div>
        <div class="bg-name">{{ localize 'dune2d20.actor.traits' }}</div>
        <div class="bg-start"></div>
        <div class="bg-data border">
            {{#each traits as |trait id|}}
                <div class="trait item" data-item-id="{{trait._id}}" data-item-type="trait">• {{trait.name}}
                    {{#if ../unlocked}}<a class="action-btn" data-action="removeItem" title="{{localize 'dune2d20.hint.removeTrait'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>{{/if}}
                </div>
            {{/each}}
        </div>
        <div class="bg-end"></div>
        {{#if (eq type "PC")}}
            <div class="bg-name">{{ localize 'dune2d20.actor.ambition' }}</div>
            <div class="bg-start"></div>
            <div class="bg-data"><input name="system.ambition" type="text" value="{{system.ambition}}" {{#unless unlocked}}readonly{{/unless}}/></div>
            <div class="bg-end"></div>
        {{else}}
            <div class="bg-name">{{ localize 'dune2d20.actor.category' }}</div>
            <div class="bg-start"></div>
            {{#if unlocked}}
                <div class="bg-data">
                    <select name="system.category">
                        {{selectOptions config.characterCategory selected=system.category  localize=true}}
                    </select>
                </div>
            {{else}}
                <div class="bg-data border">
                    <div class="categ">{{configLocalize "characterCategory" system.category}}</div>
                </div>
            {{/if}}
            <div class="bg-end"></div>
        {{/if}}
    </div>
    {{#if unlocked}}
        <div class="padlock">
            <a data-action="changeLock" title="{{localize 'dune2d20.hint.lock'}}">
                <i class="fa-solid fa-unlock"></i>
            </a>
        </div>
    {{else}}
        <div class="padlock">
            <a data-action="changeLock" title="{{localize 'dune2d20.hint.unlock'}}">
                <i class="fa-solid fa-lock"></i>
            </a>
        </div>
    {{/if}}
</header>