<header class="sheet-header">
    <div class="top-title">D U N E</div>
    {{#if unlocked}}
        <div class="padlock">
            <a data-action="changeLock" title="{{localize 'dune2d20.hint.lock'}}">
                <i class="fa-solid fa-unlock"></i>
            </a>
        </div>
    {{else}}
        <div class="padlock">
            <a data-action="changeLock" title="{{localize 'dune2d20.hint.unlock'}}">
                <i class="fa-solid fa-lock"></i>
            </a>
        </div>
    {{/if}}
    <div class="background">
        {{#if unlocked}}
            {{> "systems/dune2d20/templates/partials/house/house-background-unlocked-v2.hbs" }}
        {{else}}
            {{> "systems/dune2d20/templates/partials/house/house-background-locked-v2.hbs" }}
        {{/if}}
    </div>
    <img class="" src="{{img}}" data-action="editImage" data-field="img" title="{{name}}"/>
</header>