<section class="tab statistics-content {{tab.cssClass}}" data-group="primary" data-tab="statistics">
    <div class="statistics">
        {{#if (eq system.category "minor")}}
            <div class="stats-grid-minor">
                <!-- Drives title -->
                <div class="title">{{ localize 'dune2d20.actor.drive' }}</div>
                <div> </div>
                <div> </div>
                <div> </div>
                <!-- Generic drive -->
                <div class="drive">{{ localize 'dune2d20.actor.driveValue' }} {{#unless unlocked}}<a data-action="rollDrive" title="{{localize 'dune2d20.hint.rollDrive'}}" data-drive="genDrive"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
                <div class="val minor"><input name="system.genDrive.value" type="number" value="{{system.genDrive.value}}" min="{{system.genDrive.min}}" max="{{system.genDrive.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
                <div> </div>
                <div> </div>
        {{else}}
            <div class="stats-grid">
                <!-- Drives title -->
                <div class="title">{{ localize 'dune2d20.actor.drive' }}</div>
                <div> </div>
                <div class="title">{{ localize 'dune2d20.actor.statement' }}</div>
                <div> </div>
                <!-- Duty -->
                <div class="drive">{{ localize 'dune2d20.actor.duty' }} {{#unless unlocked}}<a data-action="rollDrive" title="{{localize 'dune2d20.hint.rollDrive'}}" data-drive="duty"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
                <div class="val"><input name="system.drives.duty.value" type="number" value="{{system.drives.duty.value}}" min="{{system.drives.duty.min}}" max="{{system.drives.duty.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
                <div class="statement"><textarea name="system.drives.duty.statement" {{#unless unlocked}}readonly{{/unless}}>{{system.drives.duty.statement}}</textarea></div>
                <div class="stat-end"> </div>
                <!-- Faith -->
                <div class="drive">{{ localize 'dune2d20.actor.faith' }} {{#unless unlocked}}<a data-action="rollDrive" title="{{localize 'dune2d20.hint.rollDrive'}}" data-drive="faith"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
                <div class="val"><input name="system.drives.faith.value" type="number" value="{{system.drives.faith.value}}" min="{{system.drives.faith.min}}" max="{{system.drives.faith.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
                <div class="statement"><textarea name="system.drives.faith.statement" {{#unless unlocked}}readonly{{/unless}}>{{system.drives.faith.statement}}</textarea></div>
                <div class="stat-end"> </div>
                <!-- Justice -->
                <div class="drive">{{ localize 'dune2d20.actor.justice' }} {{#unless unlocked}}<a data-action="rollDrive" title="{{localize 'dune2d20.hint.rollDrive'}}" data-drive="justice"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
                <div class="val"><input name="system.drives.justice.value" type="number" value="{{system.drives.justice.value}}" min="{{system.drives.justice.min}}" max="{{system.drives.justice.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
                <div class="statement"><textarea name="system.drives.justice.statement" {{#unless unlocked}}readonly{{/unless}}>{{system.drives.justice.statement}}</textarea></div>
                <div class="stat-end"> </div>
                <!-- Power -->
                <div class="drive">{{ localize 'dune2d20.actor.power' }} {{#unless unlocked}}<a data-action="rollDrive" title="{{localize 'dune2d20.hint.rollDrive'}}" data-drive="power"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
                <div class="val"><input name="system.drives.power.value" type="number" value="{{system.drives.power.value}}" min="{{system.drives.power.min}}" max="{{system.drives.power.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
                <div class="statement"><textarea name="system.drives.power.statement" {{#unless unlocked}}readonly{{/unless}}>{{system.drives.power.statement}}</textarea></div>
                <div class="stat-end"> </div>
                <!-- Truth -->
                <div class="drive">{{ localize 'dune2d20.actor.truth' }} {{#unless unlocked}}<a data-action="rollDrive" title="{{localize 'dune2d20.hint.rollDrive'}}" data-drive="truth"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
                <div class="val"><input name="system.drives.truth.value" type="number" value="{{system.drives.truth.value}}" min="{{system.drives.truth.min}}" max="{{system.drives.truth.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
                <div class="statement"><textarea name="system.drives.truth.statement" {{#unless unlocked}}readonly{{/unless}}>{{system.drives.truth.statement}}</textarea></div>
                <div class="stat-end"> </div>
        {{/if}}

            <!-- Skills title -->
            <div class="title">{{ localize 'dune2d20.actor.skill' }}</div>
            <div> </div>
            <div class="title">{{ localize 'dune2d20.actor.focuses' }}</div>
            <div> </div>
            <!-- Battle -->
            <div class="skill">{{ localize 'dune2d20.actor.battle' }} {{#unless unlocked}}<a data-action="rollSkill" title="{{localize 'dune2d20.hint.rollSkill'}}" data-skill="battle"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
            <div class="val"><input name="system.skills.battle.value" type="number" value="{{system.skills.battle.value}}" min="{{system.skills.battle.min}}" max="{{system.skills.battle.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
            <div class="focuses">
                {{#each focuses as |focus id|}}
                    {{#if (eq focus.system.skill "battle") }}
                        <div class="focus item" data-item-id="{{focus._id}}" data-item-type="focus">• {{focus.name}}
                            {{#if ../unlocked}}<a class="action-btn" data-action="removeItem" title="{{localize 'dune2d20.hint.removeFocus'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>{{/if}}
                        </div>
                    {{/if}}
                {{/each}}
            </div>
            <div class="stat-end"> </div>
            <!-- Communicate -->
            <div class="skill">{{ localize 'dune2d20.actor.communicate' }} {{#unless unlocked}}<a data-action="rollSkill" title="{{localize 'dune2d20.hint.rollSkill'}}" data-skill="communicate"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
            <div class="val"><input name="system.skills.communicate.value" type="number" value="{{system.skills.communicate.value}}" min="{{system.skills.communicate.min}}" max="{{system.skills.communicate.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
            <div class="focuses">
                {{#each focuses as |focus id|}}
                    {{#if (eq focus.system.skill "communicate") }}
                        <div class="focus item" data-item-id="{{focus._id}}" data-item-type="focus">• {{focus.name}}
                            {{#if ../unlocked}}<a class="action-btn" data-action="removeItem" title="{{localize 'dune2d20.hint.removeFocus'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>{{/if}}
                        </div>
                    {{/if}}
                {{/each}}
            </div>  
            <div class="stat-end"> </div>
            <!-- Discipline -->
            <div class="skill">{{ localize 'dune2d20.actor.discipline' }} {{#unless unlocked}}<a data-action="rollSkill" title="{{localize 'dune2d20.hint.rollSkill'}}" data-skill="discipline"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
            <div class="val"><input name="system.skills.discipline.value" type="number" value="{{system.skills.discipline.value}}" min="{{system.skills.discipline.min}}" max="{{system.skills.discipline.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
            <div class="focuses">
                {{#each focuses as |focus id|}}
                    {{#if (eq focus.system.skill "discipline") }}
                        <div class="focus item" data-item-id="{{focus._id}}" data-item-type="focus">• {{focus.name}}
                            {{#if ../unlocked}}<a class="action-btn" data-action="removeItem" title="{{localize 'dune2d20.hint.removeFocus'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>{{/if}}
                        </div>
                    {{/if}}
                {{/each}}
            </div>
            <div class="stat-end"> </div>
            <!-- Move -->
            <div class="skill">{{ localize 'dune2d20.actor.move' }} {{#unless unlocked}}<a data-action="rollSkill" title="{{localize 'dune2d20.hint.rollSkill'}}" data-skill="move"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
            <div class="val"><input name="system.skills.move.value" type="number" value="{{system.skills.move.value}}" min="{{system.skills.move.min}}" max="{{system.skills.move.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
            <div class="focuses">
                {{#each focuses as |focus id|}}
                    {{#if (eq focus.system.skill "move") }}
                        <div class="focus item" data-item-id="{{focus._id}}" data-item-type="focus">• {{focus.name}}
                            {{#if ../unlocked}}<a class="action-btn" data-action="removeItem" title="{{localize 'dune2d20.hint.removeFocus'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>{{/if}}
                        </div>
                    {{/if}}
                {{/each}}
            </div>    
            <div class="stat-end"> </div>
            <!-- Understand -->
            <div class="skill">{{ localize 'dune2d20.actor.understand' }} {{#unless unlocked}}<a data-action="rollSkill" title="{{localize 'dune2d20.hint.rollSkill'}}" data-skill="understand"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
            <div class="val"><input name="system.skills.understand.value" type="number" value="{{system.skills.understand.value}}" min="{{system.skills.understand.min}}" max="{{system.skills.understand.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
            <div class="focuses">
                {{#each focuses as |focus id|}}
                    {{#if (eq focus.system.skill "understand") }}
                        <div class="focus item" data-item-id="{{focus._id}}" data-item-type="focus">• {{focus.name}}
                            {{#if ../unlocked}}<a class="action-btn" data-action="removeItem" title="{{localize 'dune2d20.hint.removeFocus'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>{{/if}}
                        </div>
                    {{/if}}
                {{/each}}
            </div>
            <div class="stat-end"> </div>
        </div>
        <div class="col-right">
            <div> </div>
            <div class="talents-flex">
                <div class="top-row"> </div>
                <div class="title-row">{{ localize 'dune2d20.actor.talents' }}</div>
                {{#each talents as |talent id|}}
                    <div class="talent-row item" data-item-id="{{talent._id}}" data-item-type="talent">
                        <div class="talent-name">• {{talent.name}}</div>
                        {{#if ../unlocked}}
                            <a class="edit-item" data-action="editItem" title="{{localize 'dune2d20.hint.editTalent'}}"><i class="fa-regular fa-sliders"></i></a>
                            <a class="remove-item" data-action="removeItem" title="{{localize 'dune2d20.hint.removeTalent'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>
                        </div>
                        {{else}}
                            {{#if system.descVisible}}
                                <a class="toogle-desc" data-action="hide" title="{{localize 'dune2d20.hint.hideTalentDesc'}}"><i class="fa-solid fa-caret-up"></i></a>
                            </div>
                            <div class="desc-row">{{editor system.ruleText target="system.ruleText" button=false owner=true editable=false}}</div>
                            {{else}}
                                <a class="toogle-desc" data-action="show" title="{{localize 'dune2d20.hint.showTalentDesc'}}"><i class="fa-solid fa-caret-down"></i></a>
                            </div>
                            {{/if}}
                        {{/if}}
                {{/each}}       
                <div class="bottom-row"> </div>
            </div>
            <div> </div>
            <div> </div>
            <div class="assets-flex">
                <div class="top-row"> </div>
                <div class="title-row">{{ localize 'dune2d20.actor.assets' }}</div>
                {{#each assets as |asset id|}}
                    <div class="asset-row item" data-item-id="{{asset._id}}" data-item-type="asset">
                        <div class="asset-name">• {{asset.name}} <span class="quality"><i class="fa-solid fa-star-sharp" title="{{localize 'dune2d20.hint.quality'}}"></i> {{asset.system.quality}}</span></div>
                        {{#if ../unlocked}}
                            <a class="edit-item" data-action="editItem" title="{{localize 'dune2d20.hint.editAsset'}}"><i class="fa-regular fa-sliders"></i></a>
                            <a class="remove-item" data-action="removeItem" title="{{localize 'dune2d20.hint.removeAsset'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>
                        </div>
                        {{else}}
                            {{#if system.descVisible}}
                                <a class="toogle-desc" data-action="hide" title="{{localize 'dune2d20.hint.hideAssetDesc'}}"><i class="fa-solid fa-caret-up"></i></a>
                            </div>
                            <div class="desc-row">{{editor system.description target="system.description" button=false owner=true editable=false}}</div>
                            {{else}}
                                <a class="toogle-desc" data-action="show" title="{{localize 'dune2d20.hint.showAssetDesc'}}"><i class="fa-solid fa-caret-down"></i></a>
                            </div>
                            {{/if}}
                        {{/if}}
                {{/each}}
                <div class="bottom-row"> </div>
            </div>
            <div> </div>
            {{#if (eq type "PC")}}
                <div class="adv-det-grid ">
                    <div class="title left">{{ localize 'dune2d20.actor.advancement' }}</div>
                    <div class="title right">{{ localize 'dune2d20.actor.determination' }}</div>
                    <div class="back"> </div>
                    <div class="val adv"><input name="system.resources.advancementPoints.value" type="number" value="{{system.resources.advancementPoints.value}}" min="{{system.resources.advancementPoints.min}}" {{#unless unlocked}}readonly{{/unless}}></div>
                    <div class="val det"><input name="system.resources.determination.value" type="number" value="{{system.resources.determination.value}}" min="{{system.resources.determination.min}}" max="{{system.resources.determination.max}}" {{#unless unlocked}}readonly{{/unless}}></div>
                </div>
            {{/if}}
            {{#if (eq type "SC")}}
                <div class="cost-grid ">
                    <div class="cost-name">{{ localize 'dune2d20.actor.cost' }}</div>
                    <div class="cost-box"></div>
                    <div class="cost-val"><input name="system.cost" type="number" value="{{system.cost}}" min="0" {{#unless unlocked}}readonly{{/unless}}></div>
                </div>
            {{/if}}
        </div>
    </div>
</section>