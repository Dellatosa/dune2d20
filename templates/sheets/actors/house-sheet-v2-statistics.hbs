<section class="tab statistics-content {{tab.cssClass}}" data-group="primary" data-tab="statistics">
    <div class="statistics">
        <div class="stats-grid">
            <!-- House skills title -->
            <div class="title">{{ localize 'dune2d20.actor.skill' }}</div>
            <div> </div>
            {{#if unlocked}}
                {{> "systems/dune2d20/templates/partials/house/house-skills-unlocked-v2.hbs" }}
            {{else}}
                {{> "systems/dune2d20/templates/partials/house/house-skills-locked-v2.hbs" }}
            {{/if}}
        </div>
        <div> </div>
        <div>
            <div class="overview-grid">
                <!-- Overview title -->
                <div class="title">{{ localize 'dune2d20.actor.overview' }}</div>
                {{#if unlocked}}
                    {{> "systems/dune2d20/templates/partials/house/house-overview-unlocked-v2.hbs" }}
                {{else}}
                    {{> "systems/dune2d20/templates/partials/house/house-overview-locked-v2.hbs" }}
                {{/if}}
            </div>
            <div class="domain-income-grid">
                <!-- Domain income title -->
                <div class="title">{{ localize 'dune2d20.actor.domainIncome' }}</div>
                {{> "systems/dune2d20/templates/partials/house/house-dom-income-v2.hbs" }}
            </div>
        </div>
    </div>
    <div class="comp-ventures-grid">
        <div> </div>
        <div class="comp-ventures-flex">
            <div class="top-row"> </div>
            <div class="title-row">{{ localize 'dune2d20.actor.compVentures' }}</div>
            {{#if unlocked}}
                {{> "systems/dune2d20/templates/partials/house/house-comp-ventures-unlocked-v2.hbs" }}
            {{else}}
                {{> "systems/dune2d20/templates/partials/house/house-comp-ventures-locked-v2.hbs" }}
            {{/if}}
            <div class="bottom-row"> </div>
        </div>
        <div> </div>
    </div>
</section>