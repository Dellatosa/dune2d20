<section class="tab statistics-content {{tab.cssClass}}" data-group="primary" data-tab="statistics">
    <div class="statistics">
        <div class="stats-grid">
            <!-- House skills title -->
            <div class="title">{{ localize 'dune2d20.actor.skill' }}</div>
            <div> </div>
            <!-- Battle -->
            <div class="skill">{{ localize 'dune2d20.actor.battle' }}</div>
            <div class="val"><input name="system.skills.battle.value" type="number" value="{{system.skills.battle.value}}" min="{{system.skills.battle.min}}" max="{{system.skills.battle.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
            <!-- Communicate -->
            <div class="skill">{{ localize 'dune2d20.actor.communicate' }}</div>
            <div class="val"><input name="system.skills.communicate.value" type="number" value="{{system.skills.communicate.value}}" min="{{system.skills.communicate.min}}" max="{{system.skills.communicate.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
            <!-- Discipline -->
            <div class="skill">{{ localize 'dune2d20.actor.discipline' }}</div>
            <div class="val"><input name="system.skills.discipline.value" type="number" value="{{system.skills.discipline.value}}" min="{{system.skills.discipline.min}}" max="{{system.skills.discipline.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
            <!-- Move -->
            <div class="skill">{{ localize 'dune2d20.actor.move' }}</div>
            <div class="val"><input name="system.skills.move.value" type="number" value="{{system.skills.move.value}}" min="{{system.skills.move.min}}" max="{{system.skills.move.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
            <!-- Understand -->
            <div class="skill">{{ localize 'dune2d20.actor.understand' }}</div>
            <div class="val"><input name="system.skills.understand.value" type="number" value="{{system.skills.understand.value}}" min="{{system.skills.understand.min}}" max="{{system.skills.understand.max}}" {{#unless unlocked}}readonly{{/unless}}/></div>
            <!-- Skills upkeep> -->
            <div> </div>
            <div> </div>
            <div class="skill">{{ localize 'dune2d20.actor.skillUpkeep' }}</div>
            <div class="skill-upkeep"><input name="system.skillsUpkeep" type="number" value="{{system.skillsUpkeep}}" readonly/></div>
        </div>
        <div> </div>
        <div>
            <div class="overview-grid">
                <!-- Overview title -->
                <div class="title">{{ localize 'dune2d20.actor.overview' }}</div>
                <div class="field-name start">{{ localize 'dune2d20.actor.militaryPower' }}</div>
                <div class="modifier">{{ localize 'dune2d20.actor.modifier' }}</div>
                <div> </div>
                <div class="upkeep">{{ localize 'dune2d20.actor.upkeep' }}</div>
                <div> </div>
                <div class="field-start"> </div>
                {{#if unlocked}}
                    <div class="field-data">
                        <select name="system.militaryPower">
                            {{selectOptions config.militaryPowerLevel selected=system.militaryPower labelAttr="label" localize=true}}
                        </select>
                    </div>
                {{else}}
                    <div class="field-data locked">
                        {{configLocalizeLabel "militaryPowerLevel" system.militaryPower}}
                    </div>
                {{/if}}
                <div class="field-end"> </div>
                <div> </div>
                <div class="val"><input name="system.militaryPowerDifficulty" type="number" value="{{system.militaryPowerDifficulty}}" readonly/></div>
                <div> </div>
                <div class="val"><input name="system.militaryPowerUpkeep" type="number" value="{{system.militaryPowerUpkeep}}" readonly/></div>
                <div> </div>
                <div class="field-name">{{ localize 'dune2d20.actor.populationLoyalty' }}</div>
                <div class="field-start"> </div>
                {{#if unlocked}}
                    <div class="field-data">
                        <select name="system.populationLoyalty">
                            {{selectOptions config.populationLoyaltyLevel selected=system.populationLoyalty labelAttr="label" localize=true}}
                        </select>
                    </div>
                {{else}}
                    <div class="field-data locked">
                        <div>{{configLocalizeLabel "populationLoyaltyLevel" system.populationLoyalty}}</div>
                    </div>
                {{/if}}
                <div class="field-end"> </div>
                <div> </div>
                <div class="val"><input name="system.populationLoyaltyModifier" type="number" value="{{system.populationLoyaltyModifier}}" readonly/></div>
                <div> </div>
                <div class="val"><input name="system.populationLoyaltyUpkeep" type="number" value="{{system.populationLoyaltyUpkeep}}" readonly/></div>
                <div> </div>
                <div class="field-name">{{ localize 'dune2d20.actor.lifestyle' }}</div>
                <div class="field-start"> </div>
                {{#if unlocked}}
                    <div class="field-data">
                        <select name="system.lifestyle">
                            {{selectOptions config.lifestyleLevel selected=system.lifestyle labelAttr="label" localize=true}}
                        </select>
                    </div>
                {{else}}
                    <div class="field-data locked">
                        <div>{{configLocalizeLabel "lifestyleLevel" system.lifestyle}}</div>
                    </div>
                {{/if}}
                <div class="field-end"> </div>
                <div> </div>
                <div class="val">&nbsp;</div>
                <div> </div>
                <div class="val"><input name="system.lifestyleUpkeep" type="number" value="{{system.lifestyleUpkeep}}" readonly/></div>
                <div> </div>
            </div>
            <div class="domain-income-grid">
                <!-- Domain income title -->
                <div class="title">{{ localize 'dune2d20.actor.domainIncome' }}</div>
                <div class="field-name start">&nbsp;</div>
                <div class="resources">{{ localize 'dune2d20.actor.resources' }}</div>
                <div> </div>
                <div class="wealth">{{ localize 'dune2d20.actor.wealth' }}</div>
                <div> </div>
                {{#each domains as |domain id|}}
                    <div class="field-start"> </div>
                    <div class="field-data domain" title="{{domain.name}}">
                    {{#if domain.system.primary}}
                        <i class="fa-solid fa-square-1" title="{{localize 'dune2d20.hint.primaryDomain'}}"></i>
                    {{else}}
                        <i class="fa-solid fa-square-2" title="{{localize 'dune2d20.hint.secondaryDomain'}}"></i>
                    {{/if}} {{domain.name}}
                    </div>
                    <div class="field-end"> </div>
                    <div> </div>
                    <div class="val"><input name="system.resourcesIncome" type="number" value="{{domain.system.resourcesIncome}}" readonly/></div>
                    <div> </div>
                    <div class="val"><input name="system.wealthIncome" type="number" value="{{domain.system.wealthIncome}}" readonly/></div>
                    <div> </div>
                {{/each}}
            </div>
        </div>
    </div>
    <div class="comp-ventures-grid">
        <div> </div>
        <div class="comp-ventures-flex">
            <div class="top-row"> </div>
            <div class="title-row">{{ localize 'dune2d20.actor.compVentures' }}</div>
            <!-- TODO -->
            <div class="bottom-row"> </div>
        </div>
        <div> </div>
    </div>
</section>