<section class="tab management-content {{tab.cssClass}}" data-group="primary" data-tab="management">
    <div class="section-title">{{ localize 'dune2d20.actor.reputation' }}</div>
    <div class="rep-grid">
        <div> </div>
        <div class="rep-block">
            <div class="rep-top"> </div>
            <div class="title-row">{{ localize 'dune2d20.actor.traits' }}</div>
            <div class="rep-data">
                {{#if (and (ne system.statusLevel "respected") system.statusLevel)}}
                    <div class="trait item" title="{{localize 'dune2d20.hint.statusTrait'}}">• {{configLocalizeLabel "status" system.statusLevel}}</div>
                {{/if}}
                {{#if (and (ne system.lifestyle "noble") (ne system.lifestyle "empty"))}}
                    <div class="trait item" title="{{localize 'dune2d20.hint.lifestyleTrait'}}">• {{configLocalizeTrait "lifestyleLevel" system.lifestyle}}</div>
                {{/if}}
                {{#each traits as |trait id|}}
                    <div class="trait item" data-item-id="{{trait._id}}" data-item-type="trait">• {{trait.name}}
                        {{#if ../unlocked}}<a class="action-btn" data-action="removeItem" title="{{localize 'dune2d20.hint.removeTrait'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>{{/if}}
                    </div>
                {{/each}}
            </div>
            <div class="rep-bottom"> </div>
        </div>
        <div> </div>
    </div>
    <div class="section-title">{{ localize 'dune2d20.actor.houseManagement' }}</div>
    <div class="manage-pools-grid">
        <div class="pool-name left">{{ localize 'dune2d20.actor.totalWealth' }}</div>
        <div class="pool-name middle">{{ localize 'dune2d20.actor.totalResources' }}</div>
        <div class="pool-name right">{{ localize 'dune2d20.actor.totalUpkeep' }}</div>
        <div class="pool-box left"></div>
        <div class="pool-val left"><input name="system.totalWealth" type="number" value="{{system.totalWealth}}" {{#unless unlocked}}readonly{{/unless}}/></div>
        <div class="pool-box middle"></div>
        <div class="pool-val middle"><input name="system.totalResources" type="number" value="{{system.totalResources}}" {{#unless unlocked}}readonly{{/unless}}/></div>
        <div class="pool-box right"></div>
        <div class="pool-val right"><input name="system.totalUpkeep" type="number" value="{{system.totalUpkeep}}" readonly/></div>
    </div>
    <div class="news-events">
        <div class="news-block">
            <div class="news-top"> </div>
            <div class="title-row">{{ localize 'dune2d20.actor.newsImperium' }}</div>
            <!-- TODO -->
            <div class="news-bottom"> </div>
        </div>
        <div class="events-block">
            <div class="news-top"> </div>
            <div class="title-row">{{ localize 'dune2d20.actor.events' }}</div>
            <!-- TODO -->
            <div class="news-bottom"> </div>
        </div>
    </div>
    <div class="dev-ventures-grid">
        <div> </div>
        <div class="dev-ventures-flex">
            <div class="top-row"> </div>
            <div class="title-row">{{ localize 'dune2d20.actor.devVentures' }}</div>
            <!-- TODO -->
            <div class="bottom-row"> </div>
        </div>
        <div> </div>
    </div>
</section>