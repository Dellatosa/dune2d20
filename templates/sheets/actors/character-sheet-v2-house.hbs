<section class="tab house-content {{tab.cssClass}}" data-group="primary" data-tab="house">
 <div class="house-stats-grid">
    <div class="title left">{{ localize 'dune2d20.actor.characterDrive' }}</div>
    <div> </div>
    <div class="title right">{{ localize 'dune2d20.actor.houseSkill' }}</div>
    <div> </div>
    <!-- Duty -->
    <div class="drive">{{ localize 'dune2d20.actor.duty' }} {{#unless unlocked}}<a data-action="rollDriveHouse" title="{{localize 'dune2d20.hint.rollDrive'}}" data-drive="duty"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
    <div class="val"><input name="system.drives.dutyH.value" type="number" value="{{system.drives.duty.value}}" min="{{system.drives.duty.min}}" max="{{system.drives.duty.max}}" readonly/></div>
    <div> </div>
    <!-- Battle -->
    <div class="skill">{{ localize 'dune2d20.actor.battle' }} {{#unless unlocked}}<a data-action="rollSkillHouse" title="{{localize 'dune2d20.hint.rollSkill'}}" data-skill="battle"><i class="fa-solid fa-dice-d20"></i></a>{{/unless}}</div>
