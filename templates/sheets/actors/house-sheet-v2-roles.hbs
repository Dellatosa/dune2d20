<section class="tab roles-content {{tab.cssClass}}" data-group="primary" data-tab="roles">
    <div class="section-title">{{ localize 'dune2d20.actor.rolesStats' }}</div>
    <div class="roles-stats">
        <div> </div>
        <div class="stat-name left">{{ localize 'dune2d20.actor.additionalRoles' }}</div>
        <div class="stat-name middle">{{ localize 'dune2d20.actor.activeRoles' }}</div>
        <div class="stat-name right">{{ localize 'dune2d20.actor.rolesUpkeep' }}</div>
        <div> </div>
        <div> </div>
        <div class="stat-start"> </div>
        <div class="stat-data"><input name="system.additionalRoles" type="number" value="{{system.additionalRoles}}" readonly/></div>
        <div class="stat-end"> </div>
        <div> </div>
        <div class="stat-start"> </div>
        <div class="stat-data"><input name="system.activeRoles" type="number" value="{{system.activeRoles}}" {{#unless unlocked}}readonly{{/unless}}/></div>
        <div class="stat-end"> </div>
        <div> </div>
        <div class="stat-start"> </div>
        <div class="stat-data"><input name="system.rolesUpkeep" type="number" value="{{system.rolesUpkeep}}" {{#unless unlocked}}readonly{{/unless}}/></div>
        <div class="stat-end"> </div>
        <div> </div>
    </div>
