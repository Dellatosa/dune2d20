<section class="tab biography-content {{tab.cssClass}}" data-group="primary" data-tab="biography">
    <div class="biography">
        {{#if unlocked}}
            <prose-mirror name="system.biography" button="true" editable="{{unlocked}}" toggled="false" value="{{system.biography}}">
                {{{biographyHTML}}}
            </prose-mirror>
        {{else}}
            {{{biographyHTML}}}
        {{/if}}
    </div>
</section>