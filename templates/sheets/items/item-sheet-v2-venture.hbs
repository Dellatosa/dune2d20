<section class="sheet-body">
    <div class="venture-grid">
        <div class="venture-stats">
            <div class="stat">{{ localize 'dune2d20.item.type' }}</div>
            <div class="full-col">
                <select name="system.type"> 
                    {{selectOptions config.ventureType selected=system.type localize=true}}
                </select>
            </div>
            {{#if (eq system.type "construction")}}
                <div class="stat">{{ localize 'dune2d20.item.resources' }}</div>
                <div class="val"><input name="system.resources" type="number" value="{{system.resources}}" min="0" max="99"/></div>
            {{/if}}
            {{#if (eq system.type "boon")}}
                <div class="stat">{{ localize 'dune2d20.item.wealth' }}</div>
                <div class="val"><input name="system.wealth" type="number" value="{{system.wealth}}" min="0" max="99"/></div>
            {{/if}}
            <div class="stat">{{ localize 'dune2d20.item.skill' }}</div>
            <div class="full-col">
                <select name="system.skill">
                    {{selectOptions config.skills selected=system.skill localize=true}}
                </select>
            </div>
            <div class="stat">{{ localize 'dune2d20.item.successes' }}</div>
            <div class="val"><input name="system.successes" type="number" value="{{system.successes}}" min="0" max="5"/></div>
            <div class="stat">{{ localize 'dune2d20.item.completed' }}</div>
            <a class="chk-item" data-action="checkItem" title="{{ localize 'dune2d20.item.completed' }}" data-field="system.completed">
                {{#if system.completed}}<i class="fa-light fa-hexagon-check"></i>{{else}}<i class="fa-light fa-hexagon"></i>{{/if}}
            </a>
        </div>
         <div class="venture-desc">
            <div class="title">{{ localize 'dune2d20.item.description' }}</div>
            <div class="ed-265">
                <prose-mirror name="system.description" button="true" editable="true" toggled="false" value="{{system.description}}">
                    {{{descriptionHTML}}}
                </prose-mirror>
            </div>
        </div>
    </div>
</section>