<section class="sheet-body">
    <div class="domain-grid">
        <div class="domain-stats">
            <div class="stat">{{ localize 'dune2d20.item.primary' }}</div>
            <a class="chk-item" data-action="checkItem" title="{{ localize 'dune2d20.item.primary' }}" data-field="system.primary">
                {{#if system.primary}}<i class="fa-light fa-hexagon-check"></i>{{else}}<i class="fa-light fa-hexagon"></i>{{/if}}
            </a>
            <div class="stat"><i class="fa-solid fa-chart-pie-simple-circle-dollar"></i> {{ localize 'dune2d20.item.area' }}</div>
            <div class="full-col">
                <select name="system.area"> 
                    {{selectOptions config.areaOfExpertise selected=system.area labelAttr="label" localize=true}}
                </select>
            </div>
            <div class="stat"><i class="fa-solid fa-industry"></i> {{ localize 'dune2d20.item.section' }}</div>
            <div class="full-col">
                <select name="system.section"> 
                    {{selectOptions config.sections selected=system.section labelAttr="label" localize=true}}
                </select>
            </div>  
        </div>
         <div class="domain-desc">
            <div class="title">{{ localize 'dune2d20.item.description' }}</div>
            <div class="ed-265">
                <prose-mirror name="system.description" button="true" editable="true" toggled="false" value="{{system.description}}">
                    {{{descriptionHTML}}}
                </prose-mirror>
            </div>
        </div>
    </div>
</section>