<section class="sheet-body">
    <div class="trait-grid">
        <div class="trait-stats">
            <div class="stat">{{ localize 'dune2d20.item.temporary' }}</div>
            <a class="chk-item" data-action="checkItem" title="{{ localize 'dune2d20.item.temporary' }}" data-field="system.temporary">
                {{#if system.temporary}}<i class="fa-light fa-hexagon-check"></i>{{else}}<i class="fa-light fa-hexagon"></i>{{/if}}
            </a>
        </div>
        <div class="trait-desc">
            <div class="title">{{ localize 'dune2d20.item.description' }}</div>
            <div class="ed-265">
                <prose-mirror name="system.description" button="true" editable="true" toggled="false" value="{{system.description}}">
                    {{{descriptionHTML}}}
                </prose-mirror>
            </div>
        </div>
    </div>
</section>