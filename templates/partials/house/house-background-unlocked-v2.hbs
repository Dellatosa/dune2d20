<div class="bg-name">{{ localize 'dune2d20.actor.houseName' }}</div>
<div class="bg-start"></div>
<div class="bg-data"><input name="name" type="text" value="{{name}}" placeholder="{{ localize 'dune2d20.actor.houseNamePlaceholder' }}"/></div>
<div class="bg-end"></div>
<div class="bg-name">{{ localize 'dune2d20.actor.homeworld' }}</div>
<div class="bg-start"></div>
<div class="bg-data"><input name="system.homeworld" type="text" value="{{system.homeworld}}"/></div>
<div class="bg-end"></div>
<div class="bg-name">{{ localize 'dune2d20.actor.houseType' }}</div>
<div class="bg-start"></div>
<div class="bg-data">
    <select name="system.houseType">
        {{selectOptions config.houseType selected=system.houseType labelAttr="label" localize=true}}
    </select>
</div>
<div class="bg-end"></div>
<div class="bg-name">{{ localize 'dune2d20.actor.traits' }}</div>
<div class="bg-start"></div>
<div class="bg-data border">
    {{#each traits as |trait id|}}
        <div class="trait item" data-item-id="{{trait._id}}" data-item-type="trait">• {{trait.name}}
            <a class="action-btn" data-action="removeItem" title="{{localize 'dune2d20.hint.removeTrait'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>
        </div>
    {{/each}}
</div>
<div class="bg-end"></div>
<div class="bg-name">{{ localize 'dune2d20.actor.motto' }}</div>
<div class="bg-start"></div>
<div class="bg-data"><input name="system.motto" type="text" value="{{system.motto}}"/></div>
<div class="bg-end"></div>