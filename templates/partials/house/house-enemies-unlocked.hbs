{{#each enemies as |enemy id|}}
<div class="enemy-block">
    <div class="enemy-top"> </div>
    <div class="enemy item" data-item-id="{{enemy._id}}" data-item-type="enemy">
        <div class="enemy-name">{{enemy.name}}</div>
        <a class="edit-item" data-action="editItem" title="{{localize 'dune2d20.hint.editEnemy'}}"><i class="fa-regular fa-sliders"></i></a>
        <div class="icone"><i class="fa-solid fa-heart-crack" title="{{localize 'dune2d20.hint.hatred'}}"></i></div>
        <div class="enemy-stat">{{configLocalize "hatred" enemy.system.hatred}}</div>
        <div class="icone"><i class="fa-solid fa-khanda" title="{{localize 'dune2d20.hint.houseType'}}"></i></div>
        <div class="enemy-stat">{{configLocalizeLabel "houseType" enemy.system.houseType}}</div>
        <a class="remove-item" data-action="removeItem" title="{{localize 'dune2d20.hint.removeEnemy'}}"><i class="fa-solid fa-hexagon-xmark"></i></a>
        <div class="icone"><i class="fa-solid fa-cloud-bolt" title="{{localize 'dune2d20.hint.enemyReason'}}"></i></div>
        <div class="enemy-stat large">{{enemy.system.reason}}</div>
    </div>
    <div class="enemy-bottom"> </div>
</div>
{{/each}}